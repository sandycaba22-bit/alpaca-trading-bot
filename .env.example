# Alpaca Markets
# Copia este archivo a .env y completa tus credenciales.
# Nunca subas .env al repositorio.
# APCA_API_BASE_URL es obligatorio (no hay default).

APCA_API_KEY_ID=your_paper_api_key_id
APCA_API_SECRET_KEY=your_paper_api_secret_key
# Paper (cuenta virtual):
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# Live (dinero real) — keys distintas (AK…), URL distinta:
# APCA_API_BASE_URL=https://api.alpaca.markets
# DRY_RUN=false + URL live = órdenes con dinero real.
# Primera orden live: TTY escribe CONFIRMO, o data/live_confirm.txt
#   línea 1: CONFIRMO
#   línea 2: account id de la cuenta live

# Bot
LOG_LEVEL=INFO
DRY_RUN=false
SCHEDULER_TICK_SECONDS=60
POLL_INTERVAL_SECONDS=60

# Planificador Tesla 3-6-9 (segundos)
TF_3M_SECONDS=180
TF_6M_SECONDS=360
TF_9M_SECONDS=540
TF_SPIKE_THRESHOLD_PCT=0.005
TF_MACRO_STRONG_PCT=2.5

# Estrategia SMA Crossover (acciones en horario US)
SYMBOLS=AAPL,MSFT
# Cripto 24/7 fuera de horario y fines de semana
CRYPTO_SYMBOLS=BTC/USD,ETH/USD
SMA_FAST=20
SMA_SLOW=50
CRYPTO_SMA_FAST=9
CRYPTO_SMA_SLOW=21
BAR_TIMEFRAME=1Day
CRYPTO_BAR_TIMEFRAME=15Min
CRYPTO_REGIME_TIMEFRAME=30Min
LOOKBACK_BARS=120

# Riesgo (paper)
MAX_OPEN_POSITIONS=3
POSITION_SIZE_PCT=0.05
MAX_NOTIONAL_PER_ORDER=2000
ALLOW_SHORT=false
STOP_LOSS_PCT=0.01
TAKE_PROFIT_PCT=0.015
CLOSE_ON_MODE_SWITCH=true
# Polvo: qty residual tras venta parcial (no operable — se cierra en libro)
DUST_THRESHOLD_PCT=0.0001
DUST_THRESHOLD_MIN_QTY=0
# Fallback cripto si Alpaca no responde; piso real = min_order_size de Alpaca
DUST_THRESHOLD_CRYPTO_MIN=0.0001
DUST_THRESHOLD_STOCK_MIN=0
# Refresco del cache min_order_size cripto (0=desactivado)
DUST_THRESHOLD_REFRESH_SECONDS=3600
# Opcional por símbolo: BTC/USD:0.00005,MSFT:0.01
DUST_THRESHOLD_OVERRIDES=
ATR_PERIOD=14
ATR_STOP_MULT=1.5
ATR_SL_MULTIPLIER=1.5
# TP más amplio (antes 3.0): deja correr ganadores; en ATR bajo aplica MIN_TP_PCT.
ATR_TP_MULTIPLIER=4.5
ATR_TRAILING_MULTIPLIER=2.0
# Piso de TP (%): evita objetivos ridículos tipo 0.45% que se come el broker.
MIN_TP_PCT=0.01
# Candado breakeven (etapa A): más tarde (antes 0.5) para no cortar trades verdes chicos.
BREAKEVEN_ACTIVATE_ATR_MULT=1.5
BREAKEVEN_BUFFER_ATR_MULT=0.25
# TP dinámico paralelo (limit resting + gap parcial 70% / trailing 30%)
DYNAMIC_TP_ENABLED=false
DYNAMIC_TP_ATR_MULT=4.5
DYNAMIC_TP_BASE_PCT=0.015
DYNAMIC_TP_MAX_PCT=0.20
DYNAMIC_TP_GAP_SELL_PCT=0.70
ADX_PERIOD=14
ADX_THRESHOLD=20
# Opcional por símbolo: AAPL:18,MSFT:22,BTC/USD:25
ADX_THRESHOLD_OVERRIDES=
ADX_FILTER_ENABLED=true
VOLUME_CONFIRMATION_PERIOD=20
VOLUME_CONFIRMATION_MULT=1.0
CONFIRM_HIGHER_TF=15Min
CONFIRM_MOMENTUM_BARS=5
ENTRY_CONFIRMATION_ENABLED=true
BREAKOUT_LOOKBACK_PERIODS=20
# Opcional: AAPL:15,MSFT:20,BTC/USD:24
BREAKOUT_LOOKBACK_OVERRIDES=
BREAKOUT_VOLUME_MULT=1.5
BREAKOUT_VOLUME_MULT_OVERRIDES=
BREAKOUT_MIN_RANGE_ATR_MULT=0.5
BREAKOUT_MIN_RANGE_OVERRIDES=
BREAKOUT_COOLDOWN_BARS=5
BREAKOUT_COOLDOWN_OVERRIDES=
# Multi-régimen (E2 mean-rev, E3 pullback, E4 squeeze)
BB_PERIOD=20
BB_STD=2.0
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MEANREV_ATR_SL_MULT=1.0
PULLBACK_EMA_PERIOD=9
PULLBACK_VOLUME_MULT=1.2
# Toque "cerca" de la EMA en tendencia (0.0045 = 0.45%)
PULLBACK_EMA_NEAR_PCT=0.0045
# Dip de continuación en tendencia_fuerte + HTF bull
TREND_PULLBACK_RSI_MIN=32
TREND_PULLBACK_RSI_MAX=70
# Fase 3: continuación cerca del techo (0.003 = 0.30%) y micro-HH en tercio superior
TREND_NEAR_HIGH_PCT=0.003
TREND_MICRO_LOOKBACK=3
TREND_RANGE_LOOKBACK=10
TREND_UPPER_FRAC=0.66
SQUEEZE_WIDTH_LOOKBACK=20
SQUEEZE_VOLUME_MULT=2.0
STRATEGY_COLLISION_PRIORITY=breakout
# Riesgo fijo por trade (0.01 = 1% del equity) y freno diario (0.03 = 3%)
USE_FIXED_RISK_SIZING=true
RISK_PERCENT_PER_TRADE=0.01
DAILY_LOSS_LIMIT_PERCENT=0.03
# WebSocket Alpaca: 0 en DATA_TIMEOUT = no matar el socket por cinta en silencio
# (el SDK ya hace ping/pong). Fallback REST solo si el socket está realmente abajo.
STREAM_STALE_SECONDS=120
STREAM_DATA_TIMEOUT_SECONDS=0
STREAM_WS_PING_INTERVAL=10
STREAM_WS_PING_TIMEOUT=180
STREAM_NOTIFY_DEBOUNCE_SECONDS=300
STREAM_RECONNECT_MIN_SECONDS=2
STREAM_RECONNECT_MAX_SECONDS=60
MOMENTUM_BARS=5
MAX_SPREAD_PCT=0.003
ADVERSE_MOMENTUM_PCT=0.008

# Ejecución: si el spread bid/ask > este umbral, orden límite (no market)
ORDER_LIMIT_SPREAD_PCT=0.0015
ORDER_RETRY_MAX=8
ORDER_RETRY_TIMEOUT_SECONDS=60
ORDER_RETRY_MAX_SL=5
ORDER_RETRY_TIMEOUT_SL_SECONDS=20
ORDER_RETRY_BACKOFF_SECONDS=1

# Backtest walk-forward (3 años train + 3 años validate)
BACKTEST_YEARS=6
BACKTEST_TRAIN_YEARS=3
BACKTEST_VALIDATE_YEARS=3
BACKTEST_CASH=100000

# Telegram (avisos de compra/venta al celular)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Avisos cuando ADX o la confirmación descartan una señal (off por defecto)
TELEGRAM_NOTIFY_FILTERED=false

# Seguridad / rate limits
API_DATA_PER_MINUTE=120
ORDER_PER_MINUTE=10
ORDER_PER_DAY=40

# Panel web (Express)
PORT=3000
HOST=0.0.0.0
# Tras HTTPS con Certbot: COOKIE_SECURE=true
COOKIE_SECURE=false
SESSION_SECRET=change_me_to_a_long_random_string
ADMIN_USER=admin
ADMIN_PASS=change_me
