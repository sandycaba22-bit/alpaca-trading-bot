# Crypto Night Fortress — paper, caja separada (copiar a .env.crypto_night en VPS)
BOT_PROFILE=crypto_night
DATA_DIR=data-crypto-night
SYMBOLS=BTC/USD,ETH/USD
SWEEP_VARIANT=V1
# Bias: 4h_1d (estricto) | 4h_only (paper — solo estructura 4H)
CRYPTO_NIGHT_BIAS_MODE=4h_only
# Candados: strict (default) | relaxed (mismos 5 candados, umbrales más flojos → más trades paper)
CRYPTO_NIGHT_FILTER_PROFILE=relaxed
CLIENT_ORDER_PREFIX=CN-
MAX_POSITIONS=1
DRY_RUN=false
POLL_INTERVAL_SECONDS=60
TELEGRAM_PREFIX=[CN]

APCA_API_KEY_ID=your_paper_api_key_id
APCA_API_SECRET_KEY=your_paper_api_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_MARKET_SESSION=true
