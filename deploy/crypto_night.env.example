# Crypto Night Fortress — paper, caja separada (copiar a .env.crypto_night en VPS)
BOT_PROFILE=crypto_night
DATA_DIR=data-crypto-night
SYMBOLS=BTC/USD,ETH/USD
SWEEP_VARIANT=V1
# Estrategia paper recomendada (ver deploy/CRYPTO_NIGHT_PAPER_STRATEGY.md)
CRYPTO_NIGHT_BIAS_MODE=4h_only
CRYPTO_NIGHT_FILTER_PROFILE=aggressive
CRYPTO_NIGHT_SESSION_MODE=always
CRYPTO_NIGHT_RISK_LIMITS=false
CRYPTO_NIGHT_MAX_TRADES_PER_NIGHT=0
CRYPTO_NIGHT_TP_REWARD_RISK=2.5
CRYPTO_NIGHT_SCALE_AT_1R=false
# SL/TP/B E (misma lógica que acciones vol_2x): tope SL 0.25%%, piso TP 1.40%%, BE/trail desde +0.70%%
CRYPTO_NIGHT_MAX_STOP_PCT=0.0021
CRYPTO_NIGHT_MIN_TP_PCT=0.0065
CRYPTO_NIGHT_MAX_TP_PCT=0.008
CRYPTO_NIGHT_TP_TARGET_PCT=0.0075
CRYPTO_NIGHT_BREAKEVEN_ACTIVATE_PCT=0.00375
CRYPTO_NIGHT_BREAKEVEN_BUFFER_PCT=0
CLIENT_ORDER_PREFIX=CN-
MAX_POSITIONS=2
DRY_RUN=false
POLL_INTERVAL_SECONDS=60
TELEGRAM_PREFIX=[CN]

APCA_API_KEY_ID=your_paper_api_key_id
APCA_API_SECRET_KEY=your_paper_api_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_MARKET_SESSION=true
