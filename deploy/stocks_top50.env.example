# Copia a .env.stocks_top50 (bot secundario Top 50, paper recomendado).
# PM2: ecosystem.stocks_top50.config.js (:3001)
#
# PAPER: cuenta Alpaca paper B (otra PK…) distinta de .env.stocks.
# Ver deploy/PAPER_DUAL_ACCOUNTS.md

BOT_PROFILE=stocks_top50
DATA_DIR=data-stocks-top50
TELEGRAM_PREFIX=[TOP50]
TELEGRAM_NOTIFY_MARKET_SESSION=true
MAX_SYMBOLS=55

APCA_API_KEY_ID=your_paper_api_key_id
APCA_API_SECRET_KEY=your_paper_api_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

LOG_LEVEL=INFO
DRY_RUN=false
# Misma API key que élite: un solo WS IEX por cuenta (élite usa stream; Top 50 REST).
MARKET_STREAM_ENABLED=false
SCHEDULER_TICK_SECONDS=90
POLL_INTERVAL_SECONDS=90

# 50 large caps — ver bot/universe.py TOP50_US_STOCK_SYMBOLS
SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,BRK.B,UNH,JNJ,XOM,JPM,V,PG,MA,HD,CVX,MRK,LLY,ABBV,PEP,KO,COST,AVGO,WMT,MCD,CSCO,TMO,ACN,ABT,DHR,WFC,DIS,VZ,CMCSA,AMD,INTU,TXN,PM,NKE,ORCL,CRM,INTC,UPS,QCOM,AMAT,HON,IBM,LOW,SBUX

SYNC_ENTRY_ENABLED=false
STOCK_ENTRY_TIMEFRAME=5Min
STOCK_REGIME_TIMEFRAME=15Min
CONFIRM_HIGHER_TF=15Min
STOCK_ENTRY_VOL_MULT=2.0
STOCK_ENTRY_VOLUME_PERIOD=20
SMA_FAST=20
SMA_SLOW=50
STOCK_ASYMMETRIC_EXITS_ENABLED=true
STOCK_ASYMMETRIC_SL_ATR_MULT=1.2
STOCK_ASYMMETRIC_TRAIL_ATR_MULT=2.75
BAR_TIMEFRAME=1Day
TF_ENTRY_SECONDS=300
LOOKBACK_BARS=120
ENTRY_CONFIRMATION_ENABLED=true
ADX_FILTER_ENABLED=true
ALLOW_SHORT=false

USE_FIXED_RISK_SIZING=true
RISK_PERCENT_PER_TRADE=0.005
MAX_OPEN_POSITIONS=5
# Paper ~$100k: ~4% equity/posición, riesgo 0.5%/trade, SL ATR — NO usar $40 (cuenta live $300).
POSITION_SIZE_PCT=0.04
MAX_NOTIONAL_PER_ORDER=12000
STOCK_TRADE_BEST_ONLY=true
CAPITAL_PROTECTION_ENABLED=true
STOCK_CAPITAL_PROTECTION_MAX_LOSS_PCT=0.03
DAILY_LOSS_LIMIT_PERCENT=0.025
# 50 símbolos: subir cupo datos/min (máx Alpaca ~200) para menos rate-limit en apertura
API_DATA_PER_MINUTE=180

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3001
HOST=0.0.0.0
COOKIE_SECURE=false
SESSION_SECRET=change_me_to_a_long_random_string
ADMIN_USER=admin
ADMIN_PASS=change_me
