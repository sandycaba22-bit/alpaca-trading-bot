# Copia a .env.crypto en la raiz del repo (no subir al git).
# Automatico en VPS: bash deploy/setup-split.sh (lee tu .env hibrido)
# PM2: ecosystem.crypto.config.js (trading-bot-crypto + trading-web-crypto :3001)
# BOT_PROFILE=crypto exige cuenta PAPER — no arranca en live.

BOT_PROFILE=crypto
DATA_DIR=data-crypto
TELEGRAM_PREFIX=[CRIPTO]

# Alpaca PAPER (cripto forever)
APCA_API_KEY_ID=your_paper_api_key_id
APCA_API_SECRET_KEY=your_paper_api_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

LOG_LEVEL=INFO
DRY_RUN=false
SCHEDULER_TICK_SECONDS=60
POLL_INTERVAL_SECONDS=60

SYMBOLS=
CRYPTO_SYMBOLS=BTC/USD,ETH/USD
CLOSE_ON_MODE_SWITCH=false

# Paper: ETH régimen SMA50 4H + ATR>1.2x (BTC sigue sync_entry)
CRYPTO_REGIME_ENTRY_ENABLED=false
CRYPTO_REGIME_ENTRY_SYMBOLS=ETH/USD
CRYPTO_ASYMMETRIC_SL_ATR_MULT=1.2
CRYPTO_ASYMMETRIC_TRAIL_ATR_MULT=2.75
CRYPTO_ASYMMETRIC_TRAIL_ACTIVATE_ATR_MULT=1.25
CRYPTO_ASYMMETRIC_TICK_SECONDS=3600

CRYPTO_SMA_FAST=9
CRYPTO_SMA_SLOW=21
CRYPTO_BAR_TIMEFRAME=15Min
CRYPTO_REGIME_TIMEFRAME=30Min
LOOKBACK_BARS=120
MAX_OPEN_POSITIONS=2
POSITION_SIZE_PCT=0.05
MAX_NOTIONAL_PER_ORDER=2000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Panel web (puerto 3001)
PORT=3001
HOST=0.0.0.0
COOKIE_SECURE=false
SESSION_SECRET=change_me_to_a_long_random_string
ADMIN_USER=admin
ADMIN_PASS=change_me
