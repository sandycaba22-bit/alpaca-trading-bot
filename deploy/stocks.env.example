# Copia a .env.stocks en la raiz del repo (no subir al git).
# PM2: ecosystem.stocks.config.js (trading-bot-stocks + trading-web-stocks :3000)
#
# Estrategia validada sweep 335031: vol_2x + SMA 50 + 5Min/15Min + salidas asimétricas.
# Rollout en 2 fases — ver deploy/STOCKS_VOL2X_LIVE.md

BOT_PROFILE=stocks
DATA_DIR=data-stocks
TELEGRAM_PREFIX=[ACCIONES]

# Alpaca LIVE (cuenta acciones ~$300)
APCA_API_KEY_ID=your_live_api_key_id
APCA_API_SECRET_KEY=your_live_api_secret_key
APCA_API_BASE_URL=https://api.alpaca.markets
# Primera orden live: data-stocks/live_confirm.txt (linea 1 CONFIRMO, linea 2 account id)

LOG_LEVEL=INFO
DRY_RUN=false
SCHEDULER_TICK_SECONDS=60
POLL_INTERVAL_SECONDS=60

# --- Fase 1 (monitorear Telegram/panel :3000 antes de fase 2) ---
SYMBOLS=AAPL,MSFT,SLV,TSLA
# --- Fase 2: ampliar a 7 simbolos OOS-validados ---
# SYMBOLS=AAPL,MSFT,SLV,TSLA,NVDA,GOOGL,META

CRYPTO_SYMBOLS=
CLOSE_ON_MODE_SWITCH=false

# Entrada = backtest vol_2x (NO sync_entry en acciones)
SYNC_ENTRY_ENABLED=false
STOCK_ENTRY_TIMEFRAME=5Min
STOCK_REGIME_TIMEFRAME=15Min
CONFIRM_HIGHER_TF=15Min
STOCK_ENTRY_VOL_MULT=2.0
STOCK_ENTRY_VOLUME_PERIOD=20
SMA_FAST=20
SMA_SLOW=50
BAR_TIMEFRAME=1Day
TF_ENTRY_SECONDS=300
LOOKBACK_BARS=120
ENTRY_CONFIRMATION_ENABLED=true
ADX_FILTER_ENABLED=true

# Salidas asimétricas acciones (sin TP fijo %)
STOCK_ASYMMETRIC_EXITS_ENABLED=true
STOCK_ASYMMETRIC_SL_ATR_MULT=1.2
STOCK_ASYMMETRIC_TRAIL_ATR_MULT=2.75

# Sizing ~$300 equity / 7 simbolos (ajustar si equity cambia)
USE_FIXED_RISK_SIZING=true
RISK_PERCENT_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
POSITION_SIZE_PCT=0.14
MAX_NOTIONAL_PER_ORDER=45
ALLOW_SHORT=false
STOCK_TRADE_BEST_ONLY=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000
HOST=0.0.0.0
COOKIE_SECURE=false
SESSION_SECRET=change_me_to_a_long_random_string
ADMIN_USER=admin
ADMIN_PASS=change_me
