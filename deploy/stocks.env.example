# Copia a .env.stocks en la raiz del repo (no subir al git).
# PM2: ecosystem.stocks.config.js (trading-bot-stocks + trading-web-stocks :3000)
#
# PAPER: usa cuenta Alpaca paper A (PK…) — NO la misma key que .env.stocks_top50.
# Ver deploy/PAPER_DUAL_ACCOUNTS.md
#
# Estrategia validada sweep 335031: vol_2x + SMA 50 + 5Min/15Min + salidas asimétricas.
# Rollout en 2 fases — ver deploy/STOCKS_VOL2X_LIVE.md

BOT_PROFILE=stocks
DATA_DIR=data-stocks
TELEGRAM_PREFIX=[ACCIONES]
# Aviso Telegram al abrir/cerrar mercado US (true por defecto)
TELEGRAM_NOTIFY_MARKET_SESSION=true

# Alpaca LIVE (cuenta acciones ~$300)
APCA_API_KEY_ID=your_live_api_key_id
APCA_API_SECRET_KEY=your_live_api_secret_key
APCA_API_BASE_URL=https://api.alpaca.markets
# Primera orden live: data-stocks/live_confirm.txt (linea 1 CONFIRMO, linea 2 account id)

LOG_LEVEL=INFO
DRY_RUN=false
SCHEDULER_TICK_SECONDS=60
POLL_INTERVAL_SECONDS=60

# Elite live — vol_2x OOS (sin MSFT, AAPL, QQQ)
SYMBOLS=SLV,TSLA,GOOGL,META,NVDA,SPY
MAX_SYMBOLS=8

CLOSE_ON_MODE_SWITCH=false

# Entrada = backtest vol_2x (NO sync_entry en acciones)
SYNC_ENTRY_ENABLED=false
# Sin STOCK_ENTRY_WINDOW_ET = entradas toda la sesión US (09:30-16:00 ET)
# STOCK_ENTRY_WINDOW_ET=09:30-16:00
STOCK_ENTRY_TIMEFRAME=5Min
STOCK_REGIME_TIMEFRAME=15Min
CONFIRM_HIGHER_TF=15Min
STOCK_ENTRY_VOL_MULT=2.0
STOCK_ENTRY_VOLUME_PERIOD=20
SMA_FAST=20
SMA_SLOW=50
BAR_TIMEFRAME=1Day
TF_ENTRY_SECONDS=300
LOOKBACK_BARS=120
ENTRY_CONFIRMATION_ENABLED=true
ADX_FILTER_ENABLED=true

# Salidas asimétricas acciones + TP ATR (ganancia >> riesgo vs SL 1.2x)
STOCK_ASYMMETRIC_EXITS_ENABLED=true
STOCK_ASYMMETRIC_SL_ATR_MULT=1.2
STOCK_ASYMMETRIC_TRAIL_ATR_MULT=2.75
# TP ~3.5R: 4.2 / 1.2 | tope 14%% por trade | piso 0.8%% (spread)
STOCK_ASYMMETRIC_TP_ATR_MULT=4.2
STOCK_ASYMMETRIC_TP_MAX_PCT=0.14
STOCK_ASYMMETRIC_TP_MIN_PCT=0.008

# Sizing — elige UN bloque según cuenta:
#
# Live ~$300 (Alpaca live):
#   RISK_PERCENT_PER_TRADE=0.01  MAX_OPEN_POSITIONS=3
#   POSITION_SIZE_PCT=0.14  MAX_NOTIONAL_PER_ORDER=45
#
# Paper / VPS ~$100k (misma API paper que Top 50):
#   RISK_PERCENT_PER_TRADE=0.01  MAX_OPEN_POSITIONS=3
#   POSITION_SIZE_PCT=0.04  MAX_NOTIONAL_PER_ORDER=12000
#
USE_FIXED_RISK_SIZING=true
RISK_PERCENT_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
POSITION_SIZE_PCT=0.14
MAX_NOTIONAL_PER_ORDER=45
ALLOW_SHORT=false
# Sin frenos extra en horario de operación (ventana STOCK_ENTRY_WINDOW_ET)
STOCK_TRADE_BEST_ONLY=false
CAPITAL_PROTECTION_ENABLED=false
# 0 = sin freno diario de nuevas entradas
DAILY_LOSS_LIMIT_PERCENT=0
API_DATA_PER_MINUTE=120

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000
HOST=0.0.0.0
COOKIE_SECURE=false
SESSION_SECRET=change_me_to_a_long_random_string
ADMIN_USER=admin
ADMIN_PASS=change_me
